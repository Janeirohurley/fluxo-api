# URL de connexion pour Prisma
DATABASE_URL="postgresql://postgres:bujumbura@localhost:5432/fluxo_db?schema=public"
SHADOW_DATABASE_URL="postgresql://postgres:bujumbura@localhost:5432/fluxo_shadow_db?schema=public"
ADMIN_APPROVAL_TOKEN="change-me"
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="smtp-user"
SMTP_PASS="smtp-password"
SMTP_FROM="noreply@example.com"
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="120"
TENANT_DATABASE_PREFIX="fluxo_tenant"
