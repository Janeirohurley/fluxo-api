generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SubscriptionRequestStatus {
  pending
  approved
  rejected
}

enum AuditActorType {
  access_key
  admin_token
  anonymous
  system
}

model AccessPlan {
  id          String             @id @default(uuid()) @db.Uuid
  code        String             @unique
  name        String
  description String?
  isActive    Boolean            @default(true) @map("is_active")
  modules     AccessPlanModule[]
  accessKeys  AccessKey[]
  approvedRequests SubscriptionRequest[] @relation("ApprovedPlan")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@map("access_plans")
}

model AccessPlanModule {
  planId     String     @db.Uuid @map("plan_id")
  moduleName String     @map("module_name")
  plan       AccessPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now()) @map("created_at")

  @@id([planId, moduleName])
  @@index([moduleName])
  @@map("access_plan_modules")
}

model AccessKey {
  id        String     @id @default(uuid()) @db.Uuid
  keyPrefix String     @map("key_prefix")
  keyHash   String     @unique @map("key_hash")
  label     String?
  planId    String     @db.Uuid @map("plan_id")
  plan      AccessPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  isActive  Boolean    @default(true) @map("is_active")
  expiresAt DateTime?  @map("expires_at")
  lastUsedAt DateTime? @map("last_used_at")
  approvedRequests SubscriptionRequest[] @relation("ApprovedAccessKey")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@index([planId])
  @@index([isActive])
  @@map("access_keys")
}

model SubscriptionRequest {
  id                  String                    @id @default(uuid()) @db.Uuid
  companyName         String                    @map("company_name")
  email               String
  notes               String?
  status              SubscriptionRequestStatus @default(pending)
  requestedModules    SubscriptionRequestModule[]
  approvedPlanId      String?                   @db.Uuid @map("approved_plan_id")
  approvedPlan        AccessPlan?               @relation("ApprovedPlan", fields: [approvedPlanId], references: [id], onDelete: SetNull)
  approvedAccessKeyId String?                   @db.Uuid @map("approved_access_key_id")
  approvedAccessKey   AccessKey?                @relation("ApprovedAccessKey", fields: [approvedAccessKeyId], references: [id], onDelete: SetNull)
  adminMessage        String?                   @map("admin_message")
  processedAt         DateTime?                 @map("processed_at")
  emailSentAt         DateTime?                 @map("email_sent_at")
  emailError          String?                   @map("email_error")
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")

  @@index([status])
  @@index([email])
  @@map("subscription_requests")
}

model SubscriptionRequestModule {
  requestId   String              @db.Uuid @map("request_id")
  moduleName  String              @map("module_name")
  request     SubscriptionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  createdAt   DateTime            @default(now()) @map("created_at")

  @@id([requestId, moduleName])
  @@index([moduleName])
  @@map("subscription_request_modules")
}

model AssetCategory {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  assets    Asset[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([name])
  @@map("categories")
}

model AssetStatus {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  assets    Asset[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([name])
  @@map("statuses")
}

model InterventionType {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @unique
  maintenanceLogs MaintenanceLog[]
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@map("intervention_types")
}

model Asset {
  id            String             @id @default(uuid()) @db.Uuid
  inventoryCode String             @unique @map("inventory_code")
  name          String
  brand         String?
  model         String?
  serialNumber  String?            @map("serial_number")
  categoryId    String             @db.Uuid @map("category_id")
  statusId      String             @db.Uuid @map("status_id")
  category      AssetCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  status        AssetStatus        @relation(fields: [statusId], references: [id], onDelete: Restrict)
  financeData   AssetFinanceData?
  assignments   AssetAssignment[]
  maintenance   MaintenanceLog[]
  transactions  FinanceTransaction[]
  journalLines  JournalEntryLine[]
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  @@map("assets")
}

model AssetFinanceData {
  assetId             String   @id @db.Uuid @map("asset_id")
  acquisitionDate     DateTime @map("acquisition_date") @db.Date
  purchaseValue       Decimal  @map("purchase_value") @db.Decimal(15, 2)
  estimatedLifeYears  Int      @map("estimated_life_years")
  residualValue       Decimal? @map("residual_value") @db.Decimal(15, 2)
  asset               Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("finance_data")
}

model AssetAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  assetId    String   @db.Uuid @map("asset_id")
  employeeId String   @db.Uuid @map("employee_id")
  locationId String   @db.Uuid @map("location_id")
  startDate  DateTime @map("start_date") @db.Date
  endDate    DateTime? @map("end_date") @db.Date
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("asset_assignments")
}

model MaintenanceLog {
  id                 String           @id @default(uuid()) @db.Uuid
  assetId            String           @db.Uuid @map("asset_id")
  interventionTypeId String           @db.Uuid @map("intervention_type_id")
  description        String?
  interventionCost   Decimal?         @map("intervention_cost") @db.Decimal(15, 2)
  provider           String?
  asset              Asset            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  interventionType   InterventionType @relation(fields: [interventionTypeId], references: [id], onDelete: Restrict)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  @@map("maintenance_logs")
}

model PaymentMethod {
  id           String             @id @default(uuid()) @db.Uuid
  name         String             @unique
  transactions FinanceTransaction[]
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  @@map("payment_methods")
}

model TransactionType {
  id           String             @id @default(uuid()) @db.Uuid
  name         String             @unique
  transactions FinanceTransaction[]
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  @@map("transaction_types")
}

model AccountingAccount {
  id                String            @id @default(uuid()) @db.Uuid
  code              String            @unique
  name              String
  accountType       String            @map("account_type")
  isActive          Boolean           @default(true) @map("is_active")
  journalEntryLines JournalEntryLine[]
  reconciliations   Reconciliation[]
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  @@index([accountType])
  @@index([isActive])
  @@map("accounting_accounts")
}

model FinanceTransaction {
  id                 String           @id @default(uuid()) @db.Uuid
  transactionTypeId  String           @db.Uuid @map("transaction_type_id")
  accountingCategory String           @map("accounting_category")
  amount             Decimal          @db.Decimal(15, 2)
  paymentMethodId    String           @db.Uuid @map("payment_method_id")
  referenceNumber    String?          @map("reference_number")
  transactionDate    DateTime         @map("transaction_date") @db.Date
  description        String?
  employeeId         String?          @db.Uuid @map("employee_id")
  assetId            String?          @db.Uuid @map("asset_id")
  paySlipId          String?          @db.Uuid @map("pay_slip_id")
  journalEntryId     String?          @db.Uuid @map("journal_entry_id")
  transactionType    TransactionType  @relation(fields: [transactionTypeId], references: [id], onDelete: Restrict)
  paymentMethod      PaymentMethod    @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  asset              Asset?           @relation(fields: [assetId], references: [id], onDelete: SetNull)
  journalEntry       JournalEntry?    @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  reconciliationItems ReconciliationItem[]
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  @@index([transactionTypeId])
  @@index([paymentMethodId])
  @@index([transactionDate])
  @@index([assetId])
  @@index([journalEntryId])
  @@map("transactions")
}

model JournalEntry {
  id            String             @id @default(uuid()) @db.Uuid
  entryNumber   String             @unique @map("entry_number")
  entryDate     DateTime           @map("entry_date") @db.Date
  description   String?
  periodYear    Int                @map("period_year")
  periodMonth   Int                @map("period_month")
  status        String
  postedAt      DateTime?          @map("posted_at")
  postedBy      String?            @db.Uuid @map("posted_by")
  lines         JournalEntryLine[]
  transactions  FinanceTransaction[]
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  @@index([entryDate])
  @@index([periodYear, periodMonth])
  @@index([status])
  @@map("journal_entries")
}

model JournalEntryLine {
  id              String                @id @default(uuid()) @db.Uuid
  journalEntryId  String                @db.Uuid @map("journal_entry_id")
  accountId       String                @db.Uuid @map("account_id")
  debitAmount     Decimal               @default(0) @map("debit_amount") @db.Decimal(15, 2)
  creditAmount    Decimal               @default(0) @map("credit_amount") @db.Decimal(15, 2)
  description     String?
  employeeId      String?               @db.Uuid @map("employee_id")
  assetId         String?               @db.Uuid @map("asset_id")
  paySlipId       String?               @db.Uuid @map("pay_slip_id")
  referenceNumber String?               @map("reference_number")
  journalEntry    JournalEntry          @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account         AccountingAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  asset           Asset?                @relation(fields: [assetId], references: [id], onDelete: SetNull)
  reconciliationItems ReconciliationItem[]
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  @@index([journalEntryId])
  @@index([accountId])
  @@index([assetId])
  @@map("journal_entry_lines")
}

model Reconciliation {
  id                    String               @id @default(uuid()) @db.Uuid
  reconciliationType    String               @map("reconciliation_type")
  accountId             String               @db.Uuid @map("account_id")
  statementStartDate    DateTime             @map("statement_start_date") @db.Date
  statementEndDate      DateTime             @map("statement_end_date") @db.Date
  statementBalance      Decimal              @map("statement_balance") @db.Decimal(15, 2)
  bookBalance           Decimal              @map("book_balance") @db.Decimal(15, 2)
  status                String
  closedAt              DateTime?            @map("closed_at")
  closedBy              String?              @db.Uuid @map("closed_by")
  account               AccountingAccount    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  items                 ReconciliationItem[]
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")

  @@index([accountId])
  @@index([status])
  @@map("reconciliations")
}

model ReconciliationItem {
  id                 String            @id @default(uuid()) @db.Uuid
  reconciliationId   String            @db.Uuid @map("reconciliation_id")
  transactionId      String?           @db.Uuid @map("transaction_id")
  journalEntryLineId String?           @db.Uuid @map("journal_entry_line_id")
  matchedAt          DateTime          @default(now()) @map("matched_at")
  reconciliation     Reconciliation    @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  transaction        FinanceTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  journalEntryLine   JournalEntryLine? @relation(fields: [journalEntryLineId], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  @@index([reconciliationId])
  @@index([transactionId])
  @@index([journalEntryLineId])
  @@map("reconciliation_items")
}

model AuditLog {
  id          String         @id @default(uuid()) @db.Uuid
  requestId   String?        @map("request_id")
  actorType   AuditActorType @map("actor_type")
  actorId     String?        @map("actor_id")
  actorLabel  String?        @map("actor_label")
  moduleName  String?        @map("module_name")
  action      String
  method      String
  path        String
  resourceType String?       @map("resource_type")
  resourceId  String?        @map("resource_id")
  statusCode  Int            @map("status_code")
  metadata    Json?
  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([requestId])
  @@index([actorType])
  @@index([moduleName])
  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}
