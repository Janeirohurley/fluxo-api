generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SubscriptionRequestStatus {
  pending
  provisioning
  approved
  failed
  rejected
}

enum AuditActorType {
  access_key
  admin_token
  anonymous
  system
}

enum CompanyProvisioningStatus {
  pending
  provisioning
  ready
  failed
}

model Company {
  id               String                @id @default(uuid()) @db.Uuid
  slug             String                @unique
  name             String
  isActive         Boolean               @default(true) @map("is_active")
  database         CompanyDatabase?
  accessKeys       AccessKey[]
  customPlans      AccessPlan[]          @relation("CompanyPlans")
  approvedRequests SubscriptionRequest[] @relation("ApprovedCompany")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  @@map("companies")
}

model CompanyDatabase {
  companyId           String                   @id @db.Uuid @map("company_id")
  databaseName        String                   @unique @map("database_name")
  connectionString    String                   @map("connection_string")
  provisioningStatus  CompanyProvisioningStatus @default(pending) @map("provisioning_status")
  provisionedAt       DateTime?                @map("provisioned_at")
  lastProvisioningError String?                @map("last_provisioning_error")
  company             Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  @@index([provisioningStatus])
  @@map("company_databases")
}

model AccessPlan {
  id          String             @id @default(uuid()) @db.Uuid
  code        String             @unique
  name        String
  description String?
  isActive    Boolean            @default(true) @map("is_active")
  companyId   String?            @db.Uuid @map("company_id")
  company     Company?           @relation("CompanyPlans", fields: [companyId], references: [id], onDelete: SetNull)
  modules     AccessPlanModule[]
  accessKeys  AccessKey[]
  approvedRequests SubscriptionRequest[] @relation("ApprovedPlan")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("access_plans")
}

model AccessPlanModule {
  planId     String     @db.Uuid @map("plan_id")
  moduleName String     @map("module_name")
  plan       AccessPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now()) @map("created_at")

  @@id([planId, moduleName])
  @@index([moduleName])
  @@map("access_plan_modules")
}

model AccessKey {
  id        String     @id @default(uuid()) @db.Uuid
  keyPrefix String     @map("key_prefix")
  keyHash   String     @unique @map("key_hash")
  label     String?
  planId    String     @db.Uuid @map("plan_id")
  plan      AccessPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  companyId String?    @db.Uuid @map("company_id")
  company   Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  isActive  Boolean    @default(true) @map("is_active")
  expiresAt DateTime?  @map("expires_at")
  lastUsedAt DateTime? @map("last_used_at")
  approvedRequests SubscriptionRequest[] @relation("ApprovedAccessKey")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@index([planId])
  @@index([companyId])
  @@index([isActive])
  @@map("access_keys")
}

model SubscriptionRequest {
  id                  String                    @id @default(uuid()) @db.Uuid
  companyName         String                    @map("company_name")
  email               String
  notes               String?
  status              SubscriptionRequestStatus @default(pending)
  requestedModules    SubscriptionRequestModule[]
  approvedPlanId      String?                   @db.Uuid @map("approved_plan_id")
  approvedPlan        AccessPlan?               @relation("ApprovedPlan", fields: [approvedPlanId], references: [id], onDelete: SetNull)
  approvedCompanyId   String?                   @db.Uuid @map("approved_company_id")
  approvedCompany     Company?                  @relation("ApprovedCompany", fields: [approvedCompanyId], references: [id], onDelete: SetNull)
  approvedAccessKeyId String?                   @db.Uuid @map("approved_access_key_id")
  approvedAccessKey   AccessKey?                @relation("ApprovedAccessKey", fields: [approvedAccessKeyId], references: [id], onDelete: SetNull)
  adminMessage        String?                   @map("admin_message")
  processedAt         DateTime?                 @map("processed_at")
  emailSentAt         DateTime?                 @map("email_sent_at")
  emailError          String?                   @map("email_error")
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")

  @@index([status])
  @@index([email])
  @@index([approvedCompanyId])
  @@map("subscription_requests")
}

model SubscriptionRequestModule {
  requestId   String              @db.Uuid @map("request_id")
  moduleName  String              @map("module_name")
  request     SubscriptionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  createdAt   DateTime            @default(now()) @map("created_at")

  @@id([requestId, moduleName])
  @@index([moduleName])
  @@map("subscription_request_modules")
}

model AuditLog {
  id          String         @id @default(uuid()) @db.Uuid
  requestId   String?        @map("request_id")
  actorType   AuditActorType @map("actor_type")
  actorId     String?        @map("actor_id")
  actorLabel  String?        @map("actor_label")
  moduleName  String?        @map("module_name")
  action      String
  method      String
  path        String
  resourceType String?       @map("resource_type")
  resourceId  String?        @map("resource_id")
  statusCode  Int            @map("status_code")
  metadata    Json?
  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([requestId])
  @@index([actorType])
  @@index([moduleName])
  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}
