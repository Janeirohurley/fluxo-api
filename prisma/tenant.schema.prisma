generator client {
  provider = "prisma-client-js"
  output   = "../generated/tenant-client"
}

datasource db {
  provider = "postgresql"
}

enum TenantAuditActorType {
  access_key
  admin_token
  anonymous
  system
}

enum PaySlipStatus {
  draft
  issued
  paid
  cancelled
}

enum PaySlipLineType {
  earning
  deduction
  tax
  benefit
}

model AssetCategory {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  assets    Asset[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("categories")
}

model AssetStatus {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  assets    Asset[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("statuses")
}

model InterventionType {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @unique
  maintenanceLogs MaintenanceLog[]
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@map("intervention_types")
}

model Asset {
  id            String             @id @default(uuid()) @db.Uuid
  inventoryCode String             @unique @map("inventory_code")
  name          String
  brand         String?
  model         String?
  serialNumber  String?            @map("serial_number")
  categoryId    String             @db.Uuid @map("category_id")
  statusId      String             @db.Uuid @map("status_id")
  category      AssetCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  status        AssetStatus        @relation(fields: [statusId], references: [id], onDelete: Restrict)
  financeData   AssetFinanceData?
  assignments   AssetAssignment[]
  maintenance   MaintenanceLog[]
  transactions  FinanceTransaction[]
  journalLines  JournalEntryLine[]
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([statusId])
  @@map("assets")
}

model AssetFinanceData {
  assetId            String   @id @db.Uuid @map("asset_id")
  acquisitionDate    DateTime @map("acquisition_date") @db.Date
  purchaseValue      Decimal  @map("purchase_value") @db.Decimal(15, 2)
  estimatedLifeYears Int      @map("estimated_life_years")
  residualValue      Decimal? @map("residual_value") @db.Decimal(15, 2)
  asset              Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("finance_data")
}

model AssetAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  assetId    String   @db.Uuid @map("asset_id")
  employeeId String   @db.Uuid @map("employee_id")
  locationId String   @db.Uuid @map("location_id")
  startDate  DateTime @map("start_date") @db.Date
  endDate    DateTime? @map("end_date") @db.Date
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([assetId])
  @@index([employeeId])
  @@index([locationId])
  @@map("asset_assignments")
}

model MaintenanceLog {
  id                 String           @id @default(uuid()) @db.Uuid
  assetId            String           @db.Uuid @map("asset_id")
  interventionTypeId String           @db.Uuid @map("intervention_type_id")
  description        String?
  interventionCost   Decimal?         @map("intervention_cost") @db.Decimal(15, 2)
  provider           String?
  asset              Asset            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  interventionType   InterventionType @relation(fields: [interventionTypeId], references: [id], onDelete: Restrict)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  @@index([assetId])
  @@index([interventionTypeId])
  @@map("maintenance_logs")
}

model PaymentMethod {
  id           String               @id @default(uuid()) @db.Uuid
  name         String               @unique
  transactions FinanceTransaction[]
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  @@map("payment_methods")
}

model TransactionType {
  id           String               @id @default(uuid()) @db.Uuid
  name         String               @unique
  transactions FinanceTransaction[]
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  @@map("transaction_types")
}

model AccountingAccount {
  id                String             @id @default(uuid()) @db.Uuid
  code              String             @unique
  name              String
  accountType       String             @map("account_type")
  isActive          Boolean            @default(true) @map("is_active")
  journalEntryLines JournalEntryLine[]
  reconciliations   Reconciliation[]
  treasuryAccounts  TreasuryAccount[]
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@index([accountType])
  @@index([isActive])
  @@map("accounting_accounts")
}

model TreasuryAccount {
  id                String            @id @default(uuid()) @db.Uuid
  name              String            @unique
  accountType       String            @map("account_type")
  currency          String            @default("BIF")
  openingBalance    Decimal           @default(0) @map("opening_balance") @db.Decimal(15, 2)
  openingBalanceDate DateTime         @map("opening_balance_date") @db.Date
  isActive          Boolean           @default(true) @map("is_active")
  accountingAccountId String?         @db.Uuid @map("accounting_account_id")
  accountingAccount AccountingAccount? @relation(fields: [accountingAccountId], references: [id], onDelete: SetNull)
  transactions      FinanceTransaction[]
  outgoingTransfers TreasuryTransfer[] @relation("TreasuryTransferFromAccount")
  incomingTransfers TreasuryTransfer[] @relation("TreasuryTransferToAccount")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  @@index([accountType])
  @@index([isActive])
  @@index([accountingAccountId])
  @@map("treasury_accounts")
}

model TreasuryTransfer {
  id                   String         @id @default(uuid()) @db.Uuid
  fromTreasuryAccountId String        @db.Uuid @map("from_treasury_account_id")
  toTreasuryAccountId   String        @db.Uuid @map("to_treasury_account_id")
  amount               Decimal        @db.Decimal(15, 2)
  transferDate         DateTime       @map("transfer_date") @db.Date
  referenceNumber      String?        @map("reference_number")
  description          String?
  fromTreasuryAccount  TreasuryAccount @relation("TreasuryTransferFromAccount", fields: [fromTreasuryAccountId], references: [id], onDelete: Restrict)
  toTreasuryAccount    TreasuryAccount @relation("TreasuryTransferToAccount", fields: [toTreasuryAccountId], references: [id], onDelete: Restrict)
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  @@index([fromTreasuryAccountId])
  @@index([toTreasuryAccountId])
  @@index([transferDate])
  @@map("treasury_transfers")
}

model FinanceTransaction {
  id                  String               @id @default(uuid()) @db.Uuid
  transactionTypeId   String               @db.Uuid @map("transaction_type_id")
  accountingCategory  String               @map("accounting_category")
  amount              Decimal              @db.Decimal(15, 2)
  paymentMethodId     String               @db.Uuid @map("payment_method_id")
  treasuryAccountId   String?              @db.Uuid @map("treasury_account_id")
  referenceNumber     String?              @map("reference_number")
  transactionDate     DateTime             @map("transaction_date") @db.Date
  description         String?
  employeeId          String?              @db.Uuid @map("employee_id")
  assetId             String?              @db.Uuid @map("asset_id")
  paySlipId           String?              @db.Uuid @map("pay_slip_id")
  journalEntryId      String?              @db.Uuid @map("journal_entry_id")
  transactionType     TransactionType      @relation(fields: [transactionTypeId], references: [id], onDelete: Restrict)
  paymentMethod       PaymentMethod        @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  treasuryAccount     TreasuryAccount?     @relation(fields: [treasuryAccountId], references: [id], onDelete: SetNull)
  asset               Asset?               @relation(fields: [assetId], references: [id], onDelete: SetNull)
  paySlip             PaySlip?             @relation(fields: [paySlipId], references: [id], onDelete: SetNull)
  journalEntry        JournalEntry?        @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  reconciliationItems ReconciliationItem[]
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  @@index([transactionTypeId])
  @@index([paymentMethodId])
  @@index([treasuryAccountId])
  @@index([transactionDate])
  @@index([assetId])
  @@index([journalEntryId])
  @@map("transactions")
}

model JournalEntry {
  id           String               @id @default(uuid()) @db.Uuid
  entryNumber  String               @unique @map("entry_number")
  entryDate    DateTime             @map("entry_date") @db.Date
  description  String?
  periodYear   Int                  @map("period_year")
  periodMonth  Int                  @map("period_month")
  status       String
  postedAt     DateTime?            @map("posted_at")
  postedBy     String?              @db.Uuid @map("posted_by")
  lines        JournalEntryLine[]
  transactions FinanceTransaction[]
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  @@index([entryDate])
  @@index([periodYear, periodMonth])
  @@index([status])
  @@map("journal_entries")
}

model JournalEntryLine {
  id                  String               @id @default(uuid()) @db.Uuid
  journalEntryId      String               @db.Uuid @map("journal_entry_id")
  accountId           String               @db.Uuid @map("account_id")
  debitAmount         Decimal              @default(0) @map("debit_amount") @db.Decimal(15, 2)
  creditAmount        Decimal              @default(0) @map("credit_amount") @db.Decimal(15, 2)
  description         String?
  employeeId          String?              @db.Uuid @map("employee_id")
  assetId             String?              @db.Uuid @map("asset_id")
  paySlipId           String?              @db.Uuid @map("pay_slip_id")
  referenceNumber     String?              @map("reference_number")
  journalEntry        JournalEntry         @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account             AccountingAccount    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  asset               Asset?               @relation(fields: [assetId], references: [id], onDelete: SetNull)
  paySlip             PaySlip?             @relation(fields: [paySlipId], references: [id], onDelete: SetNull)
  reconciliationItems ReconciliationItem[]
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  @@index([journalEntryId])
  @@index([accountId])
  @@index([assetId])
  @@map("journal_entry_lines")
}

model Reconciliation {
  id                 String               @id @default(uuid()) @db.Uuid
  reconciliationType String               @map("reconciliation_type")
  accountId          String               @db.Uuid @map("account_id")
  statementStartDate DateTime             @map("statement_start_date") @db.Date
  statementEndDate   DateTime             @map("statement_end_date") @db.Date
  statementBalance   Decimal              @map("statement_balance") @db.Decimal(15, 2)
  bookBalance        Decimal              @map("book_balance") @db.Decimal(15, 2)
  status             String
  closedAt           DateTime?            @map("closed_at")
  closedBy           String?              @db.Uuid @map("closed_by")
  account            AccountingAccount    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  items              ReconciliationItem[]
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  @@index([accountId])
  @@index([status])
  @@map("reconciliations")
}

model ReconciliationItem {
  id                 String              @id @default(uuid()) @db.Uuid
  reconciliationId   String              @db.Uuid @map("reconciliation_id")
  transactionId      String?             @db.Uuid @map("transaction_id")
  journalEntryLineId String?             @db.Uuid @map("journal_entry_line_id")
  matchedAt          DateTime            @default(now()) @map("matched_at")
  reconciliation     Reconciliation      @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  transaction        FinanceTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  journalEntryLine   JournalEntryLine?   @relation(fields: [journalEntryLineId], references: [id], onDelete: SetNull)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@index([reconciliationId])
  @@index([transactionId])
  @@index([journalEntryLineId])
  @@map("reconciliation_items")
}

model EmployeeRole {
  id          String               @id @default(uuid()) @db.Uuid
  name        String               @unique
  assignments EmployeeAssignment[]
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  @@map("roles")
}

model EmployeePosition {
  id          String               @id @default(uuid()) @db.Uuid
  name        String               @unique
  assignments EmployeeAssignment[]
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  @@map("positions")
}

model EmployeeLocation {
  id          String               @id @default(uuid()) @db.Uuid
  name        String               @unique
  assignments EmployeeAssignment[]
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  @@map("locations")
}

model Employee {
  id             String               @id @default(uuid()) @db.Uuid
  employeeNumber String               @unique @map("employee_number")
  firstName      String               @map("first_name")
  lastName       String               @map("last_name")
  email          String?              @unique
  phone          String?
  hireDate       DateTime             @map("hire_date") @db.Date
  status         String
  assignments    EmployeeAssignment[]
  contracts      EmployeeContract[]
  paySlips       PaySlip[]
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  @@index([status])
  @@index([hireDate])
  @@map("employees")
}

model EmployeeAssignment {
  id         String           @id @default(uuid()) @db.Uuid
  employeeId String           @db.Uuid @map("employee_id")
  roleId     String           @db.Uuid @map("role_id")
  positionId String           @db.Uuid @map("position_id")
  locationId String           @db.Uuid @map("location_id")
  startDate  DateTime         @map("start_date") @db.Date
  endDate    DateTime?        @map("end_date") @db.Date
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  role       EmployeeRole     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  position   EmployeePosition @relation(fields: [positionId], references: [id], onDelete: Restrict)
  location   EmployeeLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  @@index([employeeId])
  @@index([roleId])
  @@index([positionId])
  @@index([locationId])
  @@map("employee_assignments")
}

model EmployeeContract {
  id               String   @id @default(uuid()) @db.Uuid
  employeeId       String   @db.Uuid @map("employee_id")
  contractType     String   @map("contract_type")
  status           String
  startDate        DateTime @map("start_date") @db.Date
  endDate          DateTime? @map("end_date") @db.Date
  salaryAmount     Decimal  @map("salary_amount") @db.Decimal(15, 2)
  currency         String   @default("BIF")
  paymentFrequency String   @map("payment_frequency")
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  paySlips         PaySlip[]
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([employeeId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("contracts")
}

model PaySlip {
  id                String               @id @default(uuid()) @db.Uuid
  employeeId        String               @db.Uuid @map("employee_id")
  contractId        String               @db.Uuid @map("contract_id")
  payPeriodStart    DateTime             @map("pay_period_start") @db.Date
  payPeriodEnd      DateTime             @map("pay_period_end") @db.Date
  paymentDate       DateTime?            @map("payment_date") @db.Date
  issuedAt          DateTime?            @map("issued_at")
  grossAmount       Decimal              @map("gross_amount") @db.Decimal(15, 2)
  totalDeductions   Decimal              @map("total_deductions") @db.Decimal(15, 2)
  netAmount         Decimal              @map("net_amount") @db.Decimal(15, 2)
  currency          String               @default("BIF")
  status            PaySlipStatus        @default(draft)
  notes             String?
  employee          Employee             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  contract          EmployeeContract     @relation(fields: [contractId], references: [id], onDelete: Restrict)
  lines             PaySlipLine[]
  transactions      FinanceTransaction[]
  journalEntryLines JournalEntryLine[]
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  @@unique([contractId, payPeriodStart, payPeriodEnd])
  @@index([employeeId])
  @@index([contractId])
  @@index([status])
  @@index([payPeriodStart, payPeriodEnd])
  @@map("pay_slips")
}

model PaySlipLine {
  id          String          @id @default(uuid()) @db.Uuid
  paySlipId   String          @db.Uuid @map("pay_slip_id")
  lineType    PaySlipLineType @map("line_type")
  label       String
  amount      Decimal         @db.Decimal(15, 2)
  description String?
  paySlip     PaySlip         @relation(fields: [paySlipId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@index([paySlipId])
  @@index([lineType])
  @@map("pay_slip_lines")
}

model TenantAuditLog {
  id           String               @id @default(uuid()) @db.Uuid
  requestId    String?              @map("request_id")
  actorType    TenantAuditActorType @map("actor_type")
  actorId      String?              @map("actor_id")
  actorLabel   String?              @map("actor_label")
  moduleName   String?              @map("module_name")
  action       String
  method       String
  path         String
  resourceType String?              @map("resource_type")
  resourceId   String?              @map("resource_id")
  statusCode   Int                  @map("status_code")
  metadata     Json?
  beforeData   Json?                @map("before_data")
  afterData    Json?                @map("after_data")
  createdAt    DateTime             @default(now()) @map("created_at")

  @@index([requestId])
  @@index([actorType])
  @@index([moduleName])
  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@map("tenant_audit_logs")
}
